# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication - CHANGE THIS TO A SECURE VALUE
API_KEY=your-secure-api-key-here

# Browser Configuration
CHROMIUM_PATH=/usr/bin/chromium-browser
HEADLESS=true
XVFB_SCREEN=1280x720x24
NO_SANDBOX=true

# Session & Performance
SESSION_TIMEOUT=30m
MAX_CONCURRENT_PAGES=10
BROWSER_TIMEOUT=30s

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Screenshot Settings
SCREENSHOT_QUALITY=80
SCREENSHOT_DEFAULT_WIDTH=1280
SCREENSHOT_DEFAULT_HEIGHT=720

# Watch UI / Live View
LIVE_INTERVAL=400ms
LIVE_QUALITY=60
MAX_SNAPSHOTS_PER_SESSION=50

# Stealth / Anti-detection
STEALTH=true
STEALTH_USER_AGENT=

# Diagnostics
DEBUG_PPROF=false

# CORS
CORS_ORIGIN=*
